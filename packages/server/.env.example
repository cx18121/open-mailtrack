# Shared secret the extension and CLI send as `Authorization: Bearer <API_KEY>`.
API_KEY=change-me
# Public origin the pixel URL is built from, e.g. https://t.example.com
PUBLIC_URL=http://localhost:8787
# SQLite file. The Docker image expects /data/open-mailtrack.db on a volume.
DB_PATH=./open-mailtrack.db
PORT=8787

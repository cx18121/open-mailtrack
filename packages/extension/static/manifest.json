{
  "manifest_version": 3,
  "name": "open-mailtrack",
  "description": "Self-hosted open tracking for mail you send from Gmail",
  "version": "0.0.1",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://mail.google.com/"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "css": [
        "content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pageWorld.js",
        "icons/*.svg",
        "*.map"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}

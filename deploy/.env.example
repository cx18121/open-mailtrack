API_KEY=
PUBLIC_URL=https://t.example.com
TUNNEL_TOKEN=
# Optional: separate key for encrypting stored Gmail credentials and outbox payloads (defaults to API_KEY)
TOKEN_ENCRYPTION_KEY=
# Optional: server-level Google OAuth client so extension options can connect accounts in one click
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Discord webhook alerts and hygiene defaults (also configurable in extension options)
DISCORD_WEBHOOK_URL=
DISCORD_DIGEST_HOUR=
DISCORD_DIGEST_TIMEZONE=
IGNORED_IPS=
